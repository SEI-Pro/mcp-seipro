From fdbda935cf074a63c203dba4c87a8995346caf09 Mon Sep 17 00:00:00 2001
From: Pedro Soares <pedrohsoares.adv@gmail.com>
Date: Wed, 18 Nov 2026 12:56:14 -0300
Subject: [PATCH] feat(marcador): rota para remover marcador de processo
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

POST /marcador/processo/{protocolo}/remover (form: marcador) chama
AndamentoMarcadorRN::remover do core, o mesmo caminho da tela
andamento_marcador_remocao.php. Até aqui a API só adicionava marcador:
o SEI 4+ recusa marcar com marcador vazio ("Marcador não informado."),
então não havia como tirar um marcador de um processo pela API.

Antes de remover, confere que o marcador está vigente no processo e é da
unidade atual: remover() grava o andamento de remoção mesmo sem o
marcador estar no processo e não filtra por unidade.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/rn/MdWsSeiMarcadorRN.php        | 49 ++++++++++++++++++++
 src/versao/v2/MdWsSeiServicosV2.php | 11 +++++
 swagger/wssei.json                  | 70 +++++++++++++++++++++++++++++
 swagger/wssei.yaml                  | 49 ++++++++++++++++++++
 4 files changed, 179 insertions(+)

diff --git a/src/rn/MdWsSeiMarcadorRN.php b/src/rn/MdWsSeiMarcadorRN.php
index 087257d..d9a5bdd 100644
--- a/src/rn/MdWsSeiMarcadorRN.php
+++ b/src/rn/MdWsSeiMarcadorRN.php
@@ -424,4 +424,53 @@ class MdWsSeiMarcadorRN extends MarcadorRN {
     }
   }
 
+    /**
+   * M�todo que remove o marcador de um processo na unidade atual
+   * @return array
+   */
+  protected function removerMarcadorProcessoControlado(AndamentoMarcadorDTO $andamentoMarcadorDTOParam)
+    {
+    try{
+        $objInfraException = new InfraException();
+
+      if(InfraString::isBolVazia($andamentoMarcadorDTOParam->getDblIdProcedimento())){
+          $objInfraException->lancarValidacao('Processo n�o informado.');
+      }
+      if(InfraString::isBolVazia($andamentoMarcadorDTOParam->getNumIdMarcador())){
+          $objInfraException->lancarValidacao('Marcador n�o informado.');
+      }
+
+        $andamentoMarcadorRN = new AndamentoMarcadorRN();
+
+        /**
+         * AndamentoMarcadorRN::remover grava o andamento de remo��o mesmo que o
+         * marcador n�o esteja no processo, e n�o filtra por unidade. A interface
+         * web s� oferece remover marcador vigente da unidade atual; aqui vale a
+         * mesma regra.
+         */
+        $andamentoMarcadorDTO = new AndamentoMarcadorDTO();
+        $andamentoMarcadorDTO->retNumIdAndamentoMarcador();
+        $andamentoMarcadorDTO->setDblIdProcedimento($andamentoMarcadorDTOParam->getDblIdProcedimento());
+        $andamentoMarcadorDTO->setNumIdMarcador($andamentoMarcadorDTOParam->getNumIdMarcador());
+        $andamentoMarcadorDTO->setNumIdUnidade(SessaoSEI::getInstance()->getNumIdUnidadeAtual());
+        $andamentoMarcadorDTO->setStrSinUltimo('S');
+        $andamentoMarcadorDTO->setNumMaxRegistrosRetorno(1);
+
+      if($andamentoMarcadorRN->consultar($andamentoMarcadorDTO) == null){
+          $objInfraException->lancarValidacao('Marcador n�o encontrado no processo para a unidade atual.');
+      }
+
+        $dto = new AndamentoMarcadorDTO();
+        $dto->setDblIdProcedimento($andamentoMarcadorDTOParam->getDblIdProcedimento());
+        $dto->setNumIdMarcador($andamentoMarcadorDTOParam->getNumIdMarcador());
+        /** Chamando componente SEI para remover o marcador do processo */
+        $andamentoMarcadorRN->remover([$dto]);
+
+        return MdWsSeiRest::formataRetornoSucessoREST('Marcador removido do processo com sucesso.', null);
+    }catch (Exception $e){
+        LogSEI::getInstance()->gravar(InfraException::inspecionar($e));
+        return MdWsSeiRest::formataRetornoErroREST($e);
+    }
+  }
+
 }
\ No newline at end of file
