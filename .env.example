# NOT auto-loaded. TodosSettings does not read a .env file (no env_file
# in src/todos/settings.py). This is only a reference list of var names
# for `export $(cat .env)`-style shells or CI secret managers. Preferred:
# `todos setup`, which writes the password to the OS keyring (service
# `todos-mcp`) — leave SEI_SENHA empty when using it.
SEI_URL=https://sei.orgao.gov.br/sei/modulos/wssei/controlador_ws.php/api/v2
SEI_USUARIO=
SEI_SENHA=
SEI_ORGAO=0
SEI_CONTEXTO=
SEI_VERIFY_SSL=true
SEI_OCR_LANG=por

# Libera entrega de conteúdo de documentos/processos restritos (nivelAcesso=1)
# ou sigilosos (nivelAcesso=2) sem exigir confirmar_acesso_restrito=true em
# cada chamada. O disclaimer continua acompanhando cada resposta.
# Padrão: false (mais seguro — exige consentimento explícito por chamada).
SEI_PERMITIR_RESTRITOS=false
