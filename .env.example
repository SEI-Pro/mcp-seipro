SEI_URL=https://sei.orgao.gov.br/sei/modulos/wssei/controlador_ws.php/api/v2
SEI_USUARIO=
SEI_SENHA=
SEI_ORGAO=0
SEI_CONTEXTO=
SEI_VERIFY_SSL=true
SEI_OCR_LANG=por

# --- WAF / Cloudflare ---------------------------------------------------
# Se o domínio do SEI estiver atrás de um desafio do Cloudflare (Managed
# Challenge), as requisições da API são bloqueadas na borda (403 com
# qualquer credencial). A solução correta é uma regra de bypass no
# Cloudflare para /sei/modulos/wssei/ combinada com um header secreto.
# Configure aqui esse header (JSON ou "Chave:Valor,Chave2:Valor2"):
# SEI_EXTRA_HEADERS={"X-SEIPro-Key":"<segredo combinado com a regra do WAF>"}
#
# Escape hatch temporário (frágil — expira, atrelado a IP+UA): cookie
# cf_clearance obtido num browser autenticado.
# SEI_CF_CLEARANCE=
#
# Opcional: sobrescrever o User-Agent enviado pelo MCP.
# SEI_USER_AGENT=
#
# Transporte via browser real (Playwright/Chromium): contorna o desafio do
# Cloudflare roteando as requisições por dentro de um Chromium. Requer o extra
# `playwright` instalado (pip install ".[browser]" && playwright install chromium).
# No Railway, buildar a imagem com --build-arg INSTALL_BROWSER=true.
# SEI_TRANSPORT=browser
# SEI_BROWSER_HEADLESS=true
#
# Scraper web (SEIWebClient) para as tools de listagem (listar_processos,
# arvore, listar_documentos, listar_atividades, consultar_processo híbrido).
# Padrão DESLIGADO: essas tools rodam por REST. Desde o SSO Microsoft (Entra
# ID) da ANTAQ o login web não funciona mais — só ligue se tiver persistência
# de sessão configurada.
# SEI_WEB_SCRAPER=0

# Libera entrega de conteúdo de documentos/processos restritos (nivelAcesso=1)
# ou sigilosos (nivelAcesso=2) sem exigir confirmar_acesso_restrito=true em
# cada chamada. O disclaimer continua acompanhando cada resposta.
# Padrão: false (mais seguro — exige consentimento explícito por chamada).
SEI_PERMITIR_RESTRITOS=false
