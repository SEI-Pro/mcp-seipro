SEI_URL=https://sei.orgao.gov.br/sei/modulos/wssei/controlador_ws.php/api/v2
SEI_USUARIO=
SEI_SENHA=
SEI_ORGAO=0
SEI_CONTEXTO=
SEI_VERIFY_SSL=true
SEI_OCR_LANG=por

# --- Transporte / WAF Cloudflare ----------------------------------------
# SEI_TRANSPORT controla como as requisições saem:
#   auto (PADRÃO)  — usa httpx normal; se detectar um desafio do Cloudflare
#                    na borda, escala AUTOMATICAMENTE para um browser real
#                    (Playwright), se instalado. Órgãos sem WAF nunca escalam.
#   httpx          — força httpx (nunca escala p/ browser).
#   browser        — força o browser desde o início (pula a tentativa httpx).
# Deixe em branco (auto) na maioria dos casos.
# SEI_TRANSPORT=auto
# SEI_BROWSER_HEADLESS=true
#
# O escalonamento automático requer o extra `playwright` instalado
# (pip install ".[browser]" && playwright install chromium). No Railway,
# buildar a imagem com --build-arg INSTALL_BROWSER=true.
#
# Alternativas ao browser quando há WAF: (1) regra de bypass no Cloudflare do
# órgão para /sei/modulos/wssei/ + header secreto configurado abaixo; ou
# (2) cookie cf_clearance (frágil — expira, atrelado a IP+UA).
# SEI_EXTRA_HEADERS={"X-SEIPro-Key":"<segredo combinado com a regra do WAF>"}
# SEI_CF_CLEARANCE=
#
# Opcional: sobrescrever o User-Agent enviado pelo MCP.
# SEI_USER_AGENT=
#
# Scraper web (SEIWebClient) para as tools de listagem (listar_processos,
# arvore, listar_documentos, listar_atividades, consultar_processo híbrido).
# Padrão DESLIGADO: essas tools rodam por REST. Desde o SSO Microsoft (Entra
# ID) da ANTAQ o login web não funciona mais — só ligue se tiver persistência
# de sessão configurada.
# SEI_WEB_SCRAPER=0

# Libera entrega de conteúdo de documentos/processos restritos (nivelAcesso=1)
# ou sigilosos (nivelAcesso=2) sem exigir confirmar_acesso_restrito=true em
# cada chamada. O disclaimer continua acompanhando cada resposta.
# Padrão: false (mais seguro — exige consentimento explícito por chamada).
SEI_PERMITIR_RESTRITOS=false
